# ---------------------------------------------------------------------------
# OS1 / Samantha — copy to .env (never commit .env)
# ---------------------------------------------------------------------------
APP_URL=http://localhost:8000

# --- Hermes (runs on Samantha's Orgo VM, reached through a tunnel) ---
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=                       # same value as API_SERVER_KEY in the Hermes profile .env
HERMES_VOICE_MODEL=samantha-voice     # model_routes alias (fast model, reasoning off)
HERMES_WORK_MODEL=samantha-work       # model_routes alias (Claude Opus 5.5)
OS1_SESSION_KEY=agent:samantha:voice:primary

# --- Model providers (used by Hermes) ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Fish Audio (Drama 3) ---
FISH_API_KEY=
FISH_OPERATOR_VOICE_ID=               # onboarding operator
FISH_VOICE_1_ID=                      # Voice I (female, warm) — default
FISH_VOICE_2_ID=                      # Voice II (bright)
FISH_VOICE_MALE_ID=                   # optional: chosen when the user asks for a male voice

# --- LiveKit (realtime audio) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Jev (TypeSafe System One) ---
TYPESAFE_API_KEY=
JEV_TRANSPORT=live                    # live | off
JEV_MODEL=jev-1.14.0

# --- Orchestrator ---
ORCHESTRATOR_URL=http://127.0.0.1:8787
ORCHESTRATOR_PUBLIC_URL=               # Public HTTPS URL for port 8787
OS1_CLIENT_TOKEN=                     # desktop app + worker -> orchestrator bearer token (required)
OS1_INITIATION_S=6
OS1_ENABLE_DEV_RESET=0                # set to 1 only when replaying onboarding in dev
OS1_MAX_PAYMENT_USD=25.00             # hard per-call USD cap for payment tools
# OS1_ALLOWED_RECIPIENTS=             # optional comma-separated allowlist for outbound email/messages

# --- Orgo (Samantha's own cloud computer) ---
ORGO_API_KEY=
ORGO_COMPUTER_ID=                     # your Orgo computer ID

# --- Composio (slice 4) ---
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=
# COMPOSIO_ORG_API_KEY=
# COMPOSIO_SPOTIFY_AUTH_CONFIG_ID=
# COMPOSIO_TWILIO_AUTH_CONFIG_ID=
# COMPOSIO_EXA_AUTH_CONFIG_ID=

# --- Voice engine / brain ---
OS1_VOICE_ENGINE=drama3               # drama3 (our worker, exact Drama 3) | live3 (Fish Live 3 full duplex)
OS1_FAST_MODEL=claude-sonnet-5-5        # the brain: one fast call per spoken turn
OS1_BRAIN_TOKEN=                      # Fish -> brain server bearer
BRAIN_PUBLIC_URL=
FISH_AGENT_ID=

# --- Smart Free-LLM & Multi-Token Switcher (OpenRouter / NVIDIA / Awesome-Free-LLMs / OpenCode) ---
OS1_LLM_MODE=free                     # free | hybrid | anthropic
OPENROUTER_API_KEYS=                  # comma-separated keys for automatic 429 token rotation
OPENROUTER_FREE_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free,qwen/qwen3-235b-a22b:free,deepseek/deepseek-r1:free
NVIDIA_API_KEYS=                      # comma-separated NVIDIA NIM free-tier keys (build.nvidia.com)
NVIDIA_FREE_MODELS=meta/llama-3.3-70b-instruct,nvidia/llama-3.1-nemotron-ultra-253b-v1,deepseek-ai/deepseek-r1
GROQ_API_KEYS=                        # optional ultra-fast free tier (console.groq.com)
CEREBRAS_API_KEYS=                    # optional ultra-fast free tier (cloud.cerebras.ai)
GOOGLE_API_KEYS=                      # optional Gemini free tier (aistudio.google.com)
MISTRAL_API_KEYS=                     # optional Mistral free tier
OS1_FREE_LLM_CATALOG=infra/llm-router/free-llms.json

# --- OpenCode (anomalyco/opencode headless server for free models & pstack self-updates) ---
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=             # auto-generated by scripts/bootstrap_vault.py
OPENCODE_FREE_MODELS=opencode/big-pickle,opencode/glm-4.7-free

# --- Infisical Self-Managing Vault (self-hosted in docker-compose.vps.yml) ---
INFISICAL_URL=http://127.0.0.1:8080
INFISICAL_CLIENT_ID=                  # Machine Identity Universal Auth client ID
INFISICAL_CLIENT_SECRET=              # Machine Identity Universal Auth client secret
INFISICAL_PROJECT_ID=                 # Infisical project/workspace ID
INFISICAL_ENV=prod

# --- Tailscale Bridge + Hostinger VPS + Maus Bots Controller ---
TAILSCALE_HOSTNAME=samantha
TS_AUTHKEY=                           # Tailscale auth key for private HTTPS sidecar
HOSTINGER_API_TOKEN=                  # Hostinger VPS API token
HOSTINGER_VM_ID=                      # Hostinger VPS VM ID
HOSTINGER_SSH_HOST=                   # Hostinger VPS IP or Tailscale hostname
HOSTINGER_SSH_USER=root
HOSTINGER_SSH_PORT=22
SAMANTHA_SSH_KEY_PATH=.vault-staging/samantha_ed25519
MAUS_BOTS_CONFIG=infra/hostinger/maus-bots.json
OS1_ALLOWED_ORIGINS=                  # optional comma-separated extra CORS origins
