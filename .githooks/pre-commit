#!/usr/bin/env bash
# Pre-commit secret & forbidden-file guard.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

staged="$(git diff --cached --name-only --diff-filter=ACM)"
[[ -z "$staged" ]] && exit 0

blocked_files=()
while IFS= read -r f; do
  case "$f" in
    .env|.env.*|desktop.env|.vault-staging/*|*_ed25519|*.pem|*.key|*.db|*.sqlite|*.sqlite3|*.tgz|*.b64|packages/ui/src/assets/init_sound.mp3)
      [[ "$f" == ".env.example" || "$f" == *.env.example ]] || blocked_files+=("$f")
      ;;
  esac
done <<< "$staged"

if (( ${#blocked_files[@]} > 0 )); then
  echo "BLOCKED COMMIT: forbidden secret/state/asset file(s) staged:" >&2
  printf '  - %s\n' "${blocked_files[@]}" >&2
  echo "Unstage them with: git reset HEAD <file>" >&2
  exit 1
fi

# Scan staged added lines for live credential patterns (never prints matched secrets).
secret_pat='(sk-ant-[A-Za-z0-9_-]{10,}|sk-(proj-)?[A-Za-z0-9_-]{24,}|(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,}|(sk|rk|pk)_live_[A-Za-z0-9]{16,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|xox[baprs]-[A-Za-z0-9-]{10,}|\bak_[A-Za-z0-9_-]{14,})'

hits="$(git diff --cached -U0 -- . ':(exclude)*.lock' ':(exclude)package-lock.json' | grep -E '^\+[^+]' | grep -En "$secret_pat" | cut -d: -f1 | head -5 || true)"
if [[ -n "$hits" ]]; then
  echo "BLOCKED COMMIT: staged diff contains a secret-like credential pattern." >&2
  echo "Inspect your staged diff locally and remove the credential before committing." >&2
  exit 1
fi
